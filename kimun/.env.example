# Copia de referencia. Django lee estas variables del entorno (no carga .env solo).
# En desarrollo no hace falta definir ninguna.

# 1 en desarrollo, 0 en producción.
# Con 0 se activan los ajustes de producción: WhiteNoise, cookies seguras y
# SQLite en WAL en /var/lib/kimun/db.sqlite3 si no se define DJANGO_DB_PATH.
DJANGO_DEBUG=1
# Obligatoria con DJANGO_DEBUG=0. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Nombre del parámetro SecureString con la clave (p. ej. /kimun/django-secret-key).
# Solo se usa si DJANGO_SECRET_KEY está vacía.
DJANGO_SECRET_KEY_PARAMETRO=
# Región de Parameter Store. Por defecto, us-east-1.
AWS_DEFAULT_REGION=
# Separados por coma. En producción, el dominio de CloudFront.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_DB_PATH=
# Carpeta de las fotos y audios subidos cuando no hay KIMUN_BUCKET. Por defecto, kimun/media.
DJANGO_MEDIA_ROOT=
# Bucket S3 privado donde la foto espera a ser leída (en la EC2 lo define infra/remoto/instalar.sh).
# Vacío: espera en disco. En ambos casos se borra apenas se lee.
KIMUN_BUCKET=
# Solo con DJANGO_DEBUG=0. Destino de collectstatic. Por defecto, kimun/staticfiles.
DJANGO_STATIC_ROOT=
# Solo con DJANGO_DEBUG=0. Apagado: CloudFront ya redirige HTTP a HTTPS.
DJANGO_SECURE_SSL_REDIRECT=0
# Solo con DJANGO_DEBUG=0. Producción usa 3600 (dominio provisorio de CloudFront).
DJANGO_SECURE_HSTS_SECONDS=0
# Carpeta con curriculo_transicion.json y demo_curso.json. Por defecto, datos/ en la raíz del repo.
KIMUN_DATOS_DIR=

# Bedrock (Converse; Tasks 5, 7 y 8). Vacías usan el perfil de inferencia us.anthropic.claude-sonnet-5 y us-east-1.
# Las credenciales salen de la cadena estándar de AWS (rol de la instancia, credenciales temporales
# del workshop en el entorno o un perfil de la CLI); nunca se escriben en este archivo.
BEDROCK_MODEL_ID=
BEDROCK_REGION=

# Contraseña de las usuarias de prueba (educadoras, asistente y directora) que crea `manage.py cargar_demo`.
# Si no se define, el comando genera una al azar y la muestra una vez.
DEMO_PASSWORD=
